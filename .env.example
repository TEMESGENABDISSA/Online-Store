# Environment Variables Example
# Copy this file to .env.local and fill in your actual values
# .env.local should never be committed to Git

# Database URL (if using a database)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Session Secret (for authentication)
# SESSION_SECRET=your-secret-key-here

# Payment Gateway Keys (if implementing payments)
# PAYMENT_PUBLIC_KEY=pk_test_xxx
# PAYMENT_SECRET_KEY=sk_test_xxx

# Site URL (for production)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# API Keys (if using external APIs)
# NEXT_PUBLIC_API_KEY=your-api-key-here
